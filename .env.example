# ---- 클라우드 LLM (Nemotron - Personnya) ----
LLM_PROVIDER=nemotron
NEMOTRON_API_KEY=your_nemotron_api_key
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl:free
NEMOTRON_BASE_URL=https://llm.personnya.dev/v1
NEMOTRON_THINK=false

# ---- 클라우드 API (Oxion AI) ----
# LLM_PROVIDER=oxion
# OXION_API_KEY=your_oxion_api_key
# OXION_MODEL=gpt-5.6-luna
# OXION_BASE_URL=https://oxionai.com/v1

# ---- 컨텍스트 및 메모리 설정 (256K 윈도우) ----
# MAX_CONTEXT_TOKENS=262144
# SHORT_TERM_TURNS=500

# ---- 로컬 LLM (Ollama) ----
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=bonsai-2:27b    # Bonsai 2 27B (Prism ML 3진 양자화 고성능 모델)
# OLLAMA_MODEL=qwen3:14b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384
# OLLAMA_NUM_PREDICT=4096
# OLLAMA_THINK=false

# ---- TTS ----
# TTS_PROVIDER=supertonic       # Supertone Supertonic 3 (로컬 초경량 온디바이스 TTS) - 단일 엔진
# SUPERTONIC_DEVICE=cpu        # cpu (권장: GPU VRAM 경합 방지) | gpu
# SUPERTONIC_VOICE=F1          # F1~F5 (여성), M1~M5 (남성)
# SUPERTONIC_LANG=ko           # ko(한국어), ja(일본어), en(영어) 등 31개 언어
# SUPERTONIC_SPEED=1.05
# SUPERTONIC_STEPS=8
# TTS_PROVIDER=gemini          # Gemini 3.8 Flash TTS (무료 티어)
# GEMINI_API_KEY=              # Google AI Studio에서 발급
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Leda        # Leda(청량) / Aoede(산뜻) / Kore(단단) / Sulafat(따뜻)
# GEMINI_TTS_STYLE=bright, youthful, friendly and natural conversational tone
# TTS_PROVIDER=msedge          # Microsoft Edge TTS (무료 폴백)
# TTS_VOICE=ko-KR-SunHiNeural  # ko-KR-InJoonNeural (남성)
# TTS_PROVIDER=elevenlabs      # ElevenLabs (유료)
# ELEVENLABS_API_KEY=
# TTS_VOICE_ID=

# ---- STT ----
# STT_PROVIDER=whisper         # 로컬 Whisper (무료)
# STT_MODEL=Xenova/whisper-small  # 가벼운 모델 (기본)
#                              # Xenova/whisper-medium  # 정확한 모델 ( 느림)
# STT_PROVIDER=mock            # 클라이언트 Web Speech API 사용
# OPENAI_API_KEY=              # OpenAI Whisper API (유료)
# DEEPGRAM_API_KEY=            # Deepgram (유료)

# ---- 웹 검색 (Tavily AI Search) ----
# TAVILY_API_KEY=tvly-your_api_key_here

# ---- 서버 ----
PORT=25565

# ---- 로깅 (접속 IP 및 시스템 추적) ----
# LOG_DIR=server/store/logs
# LOG_LEVEL=info
# LOG_STATIC=false              # 정적 파일(.js, .css 등) 터미널 출력 여부 (기본 false, 파일에는 모두 기록됨)

# ---- RAG (Chroma) ----
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=study_materials

# ---- 메모리 ----
MEMORY_DB=server/store/memory.db
