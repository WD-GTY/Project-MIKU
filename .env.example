# ---- 클라우드 API (추후 결정 후 입력) ----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---- 로컬 LLM (Ollama) ----
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:14b
# OLLAMA_BASE_URL=http://localhost:11434

# ---- TTS ----
# TTS_PROVIDER=msedge          # Microsoft Edge TTS (무료, 한국어 고품질)
# TTS_VOICE=ko-KR-SunHiNeural  # 한국어 여성 (기본)
#                              # ko-KR-InJoonNeural (남성)
# TTS_PROVIDER=elevenlabs      # ElevenLabs (유료)
# ELEVENLABS_API_KEY=
# TTS_VOICE_ID=

# ---- STT ----
# STT_PROVIDER=whisper         # 로컬 Whisper (무료)
# STT_MODEL=Xenova/whisper-small  # 가벼운 모델 (기본)
#                              # Xenova/whisper-medium  # 정확한 모델 ( 느림)
# STT_PROVIDER=mock            # 클라이언트 Web Speech API 사용
# OPENAI_API_KEY=              # OpenAI Whisper API (유료)
# DEEPGRAM_API_KEY=            # Deepgram (유료)

# ---- 서버 ----
PORT=25565

# ---- RAG (Chroma) ----
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=study_materials

# ---- 메모리 ----
MEMORY_DB=server/store/memory.db
